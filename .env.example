# Copia este archivo a ".env" (que NUNCA se versiona, ver .gitignore) y
# completa tus propias claves. No pongas claves reales aquí ni en ningún
# archivo que se suba al repositorio.

# --- Proveedor de CHAT activo: "groq" | "google" | "github" -------------- #
LLM_PROVIDER=groq

# --- Groq (proveedor de chat activo por defecto) --------------------------- #
# Obtener en: https://console.groq.com/keys
# Modelo verificado con una llamada real a /chat/completions; si tu cuenta
# tiene acceso a otros, revisa GET https://api.groq.com/openai/v1/models.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# --- Proveedor de EMBEDDINGS activo: "local" | "google" | "github" ------- #
# Groq no ofrece API de embeddings. "local" corre sentence-transformers en
# CPU, sin costo ni llamadas de red.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Google AI Studio / Gemini (el que exige originalmente el enunciado; -- #
# --- se mantiene disponible para uso futuro) ------------------------------- #
# Obtener en: https://aistudio.google.com/app/apikey
# Modelos verificados vigentes invocando la API directamente (no solo
# client.models.list(), que puede listar modelos sin acceso de inferencia
# real); si tu cuenta tiene acceso a otros, cámbialos aquí sin tocar código.
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-3.6-flash
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# --- GitHub Models (alternativa opcional, vista en los notebooks del curso) #
GITHUB_TOKEN=
GITHUB_CHAT_MODEL=gpt-4o-mini
GITHUB_ENDPOINT=https://models.inference.ai.azure.com
GITHUB_EMBEDDING_MODEL=text-embedding-3-small

# --- Parámetros de generación y chunking ---------------------------------- #
TEMPERATURE=0.0
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVER_K=8
JUDGE_MIN_SCORE=6.0

# --- Memoria conversacional: "buffer" (historial completo) | "summary" ---- #
# (resumen progresivo, con una llamada extra al LLM por turno). Comparación
# empírica de ambas en docs/comparacion_memoria.md.
MEMORY_STRATEGY=buffer
