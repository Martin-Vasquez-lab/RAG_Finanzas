# Copia este archivo a ".env" (que NUNCA se versiona, ver .gitignore) y
# completa tus propias claves. No pongas claves reales aquí ni en ningún
# archivo que se suba al repositorio.

# --- Proveedor activo: "google" (exigido por el enunciado) o "github" ---- #
LLM_PROVIDER=google

# --- Google AI Studio / Gemini -------------------------------------------- #
# Obtener en: https://aistudio.google.com/app/apikey
# Modelos verificados vigentes vía client.models.list() (SDK google-genai);
# si tu cuenta tiene acceso a otros, cámbialos aquí sin tocar código.
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-3.6-flash
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# --- GitHub Models (alternativa opcional, vista en los notebooks del curso) #
GITHUB_TOKEN=
GITHUB_CHAT_MODEL=gpt-4o-mini
GITHUB_ENDPOINT=https://models.inference.ai.azure.com
GITHUB_EMBEDDING_MODEL=text-embedding-3-small

# --- Parámetros de generación y chunking ---------------------------------- #
TEMPERATURE=0.0
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVER_K=8
JUDGE_MIN_SCORE=6.0
