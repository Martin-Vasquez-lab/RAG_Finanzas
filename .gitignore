# --- Entornos virtuales ---------------------------------------------------- #
venv/
.venv/
env/
ENV/

# --- Python ----------------------------------------------------------------- #
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Variables de entorno / secretos ---------------------------------------- #
.env
*.env.local

# --- Índice vectorial (se regenera con `python -m src.loaders`) ------------- #
vectorstore/*.faiss
vectorstore/*.pkl
!vectorstore/.gitkeep

# --- Datos procesados intermedios -------------------------------------------- #
data/processed/*
!data/processed/.gitkeep

# --- Índice FAISS de hallazgos (memoria de largo plazo del agente, EP2) ----- #
vectorstore_hallazgos/*.faiss
vectorstore_hallazgos/*.pkl
!vectorstore_hallazgos/.gitkeep

# --- Log de casos (hallazgos de auditoría registrados en runtime, EP2) ------ #
data/casos/*.jsonl

# --- Cachés de tests / cobertura --------------------------------------------- #
.pytest_cache/
.coverage
htmlcov/

# --- IDE / SO ----------------------------------------------------------------- #
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Configuración local de Claude Code (no es parte del proyecto) ----------- #
.claude/

# --- Entregables externos (Word/PDF vía AVA y correo, NO se versionan) ------- #
docs/informe_tecnico_borrador.md
docs/guion_video_presentacion.md
*.docx

# --- Jupyter ------------------------------------------------------------------- #
.ipynb_checkpoints/
